---
import { url } from "../utils/url.ts";

export interface Props {
  variant?: "transparent" | "solid";
}

const { variant = "solid" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const stripBase = (p: string) =>
  base && p.startsWith(base) ? p.slice(base.length) || "/" : p;
const pathname = stripBase(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const links = [
  { href: "/", label: "Home" },
  { href: "/gallery", label: "Gallery" },
  { href: "/commissions", label: "Commissions" },
  { href: "/about", label: "About" },
];
---

<header class="site-nav" data-variant={variant}>
  <div class="site-nav__inner">
    <a href={url("/")} class="site-nav__brand" aria-label="Lillico Art — home">
      Lillico Art
    </a>

    <button
      class="site-nav__toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span></span><span></span>
    </button>

    <nav id="primary-nav" class="site-nav__menu" aria-label="Primary">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                href={url(l.href)}
                class:list={["site-nav__link", { "is-active": isActive(l.href) }]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={`${url("/")}#contact`} class="site-nav__link site-nav__link--cta">
            Enquire
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
    border-bottom: 1px solid transparent;
    color: var(--color-ink);
  }

  /* Solid (default) — gallery white */
  .site-nav[data-variant="solid"] {
    background: var(--color-paper);
    border-bottom-color: var(--color-rule);
  }

  /* Transparent — only on home hero, flips to solid on scroll */
  .site-nav[data-variant="transparent"] {
    background: transparent;
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.18);
  }
  .site-nav[data-variant="transparent"][data-scrolled="true"] {
    background: var(--color-paper);
    color: var(--color-ink);
    border-bottom-color: var(--color-rule);
  }

  .site-nav__inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 1.1rem clamp(1.25rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-nav__brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: inherit;
    text-decoration: none;
    line-height: 1;
  }

  .site-nav__menu {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .site-nav__menu ul {
    display: flex;
    align-items: center;
    gap: clamp(1.6rem, 2.6vw, 2.8rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: inherit;
    position: relative;
    padding: 0.4rem 0;
    transition: opacity var(--duration-fast) var(--ease-out);
    opacity: 0.78;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    opacity: 1;
  }

  .site-nav__link:hover::after,
  .site-nav__link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-nav__link--cta {
    padding: 0.6rem 1.2rem;
    border: 1px solid currentColor;
    opacity: 1;
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }
  .site-nav__link--cta::after {
    display: none;
  }
  .site-nav[data-variant="solid"] .site-nav__link--cta:hover,
  .site-nav[data-variant="transparent"][data-scrolled="true"] .site-nav__link--cta:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .site-nav[data-variant="transparent"]:not([data-scrolled="true"]) .site-nav__link--cta:hover {
    background: #ffffff;
    color: var(--color-ink);
  }

  .site-nav__toggle {
    display: none;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    color: inherit;
  }

  .site-nav__toggle span {
    display: block;
    width: 22px;
    height: 1px;
    background: currentColor;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (max-width: 768px) {
    .site-nav__toggle {
      display: flex;
    }

    .site-nav__menu {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(86vw, 360px);
      background: var(--color-paper);
      color: var(--color-ink);
      transform: translateX(100%);
      transition: transform var(--duration-base) var(--ease-out);
      padding: 6rem 2.5rem 2rem;
      border-left: 1px solid var(--color-rule);
    }

    .site-nav__menu.is-open {
      transform: translateX(0);
    }

    .site-nav__menu ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.6rem;
    }

    .site-nav__link {
      font-size: 0.95rem;
      letter-spacing: 0.16em;
    }

    .site-nav__toggle[aria-expanded="true"] span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }
    .site-nav__toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }
  }
</style>

<script>
  const initNav = () => {
    const header = document.querySelector<HTMLElement>(".site-nav");
    if (!header) return;

    if (header.dataset.variant === "transparent") {
      const onScroll = () => {
        header.dataset.scrolled = String(window.scrollY > 20);
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    const toggle = header.querySelector<HTMLButtonElement>(".site-nav__toggle");
    const menu = header.querySelector<HTMLElement>(".site-nav__menu");
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("is-open", open);
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false))
    );

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  };

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
