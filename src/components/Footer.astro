---
import { url } from "../utils/url.ts";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__mark">Lillico Art</p>
      <p class="site-footer__tag">
        Charcoal &amp; graphite portrait commissions.<br />
        Suffolk, United Kingdom.
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <div>
        <p class="eyebrow">Studio</p>
        <ul>
          <li><a href={url("/")}>Home</a></li>
          <li><a href={url("/gallery")}>Gallery</a></li>
          <li><a href={url("/commissions")}>Commissions</a></li>
          <li><a href={url("/about")}>About</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Connect</p>
        <ul>
          <li>
            <a href="mailto:lilli.co.art@gmail.com">lilli.co.art@gmail.com</a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/lilli.coart/"
              target="_blank"
              rel="noopener noreferrer">Instagram</a
            >
          </li>
          <li><a href={`${url("/")}#contact`}>Commission enquiry</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Legal</p>
        <ul>
          <li><a href={url("/privacy")}>Privacy Policy</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="site-footer__legal">
    <p>&copy; {year} Lillico Art. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    background: var(--color-surface);
    color: var(--color-ink-muted);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }

  .site-footer__inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .site-footer__brand {
    max-width: 30ch;
  }

  .site-footer__mark {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-ink);
    margin: 0 0 0.6rem;
    letter-spacing: -0.005em;
    line-height: 1;
  }

  .site-footer__tag {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .site-footer__nav .eyebrow {
    margin: 0 0 1rem;
  }

  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .site-footer__nav a {
    color: var(--color-ink);
    transition: opacity var(--duration-fast) var(--ease-out);
    font-size: 0.92rem;
    opacity: 0.8;
  }

  .site-footer__nav a:hover {
    opacity: 1;
  }

  .site-footer__legal {
    width: 100%;
    max-width: var(--container-max);
    margin: var(--space-xl) auto 0;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    border-top: 1px solid var(--color-rule);
    padding-top: var(--space-md);
    font-size: 0.78rem;
    color: var(--color-ink-faint);
  }

  .site-footer__legal p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-md);
    }
  }
</style>
