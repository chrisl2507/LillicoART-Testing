---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { featuredArtworks, artworks } from "../data/artworks.ts";
import { url } from "../utils/url.ts";

const hero = artworks.find((a) => a.slug === "masculinity")!;
const portrait = artworks.find((a) => a.slug === "en-pointe")!;

// Take 4 pieces for the 2x2 home grid
const selected = featuredArtworks.slice(0, 4);
---

<BaseLayout
  title="Charcoal Portrait Artist, Suffolk | Esme Lillico — Lillico Art"
  description="Hand-drawn charcoal and graphite portraits by Esme Lillico, based in Suffolk. Taking commissions across East Anglia — Ipswich, Cambridge, Colchester and beyond."
  ogImage="/og-default.webp"
  navVariant="transparent"
>
  {/* ======================== HERO ======================== */}
  <section class="hero">
    <div class="hero__media">
      <Image
        src={hero.image}
        alt={hero.alt}
        widths={[640, 1024, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero__image"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
    </div>

    <div class="hero__content container-page">
      <p class="hero__eyebrow">Esme Lillico</p>
      <h1 class="hero__title">Charcoal Portrait Commissions</h1>
      <p class="hero__sub">Suffolk &middot; Working across East Anglia</p>
    </div>
  </section>

  {/* ==================== SELECTED WORKS ==================== */}
  <section class="section section--selected">
    <div class="container-page">
      <header class="section__head">
        <p class="eyebrow">Selected Works</p>
        <h2 class="section__title">Recent Pieces</h2>
      </header>

      <div class="catalogue catalogue--two">
        {
          selected.map((piece) => (
            <figure class="catalogue__item">
              <div class="plate">
                <Image
                  src={piece.image}
                  alt={piece.alt}
                  widths={[480, 768, 1100]}
                  sizes="(min-width: 900px) 45vw, 92vw"
                  loading="lazy"
                />
              </div>
              <figcaption class="label">
                <p class="label__title">{piece.title}</p>
                <p class="label__meta">{piece.medium}</p>
                <p class="label__meta">{piece.dimensions}</p>
                {piece.exhibited && (
                  <p class="label__exhibited">
                    <em>Exhibited:</em> {piece.exhibited}
                  </p>
                )}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="section__foot">
        <a href={url("/gallery")} class="btn btn-ghost">View the full catalogue</a>
      </div>
    </div>
  </section>

  {/* ==================== ABOUT (compressed) ==================== */}
  <section class="section section--about">
    <div class="container-page about">
      <div class="about__image">
        <div class="plate">
          <Image
            src={portrait.image}
            alt={portrait.alt}
            widths={[400, 700, 900]}
            sizes="(min-width: 900px) 38vw, 92vw"
            loading="lazy"
          />
        </div>
      </div>
      <div class="about__text">
        <p class="eyebrow">The Artist</p>
        <h2 class="about__name">Esme Lillico</h2>
        <p>
          I'm a charcoal and graphite portrait artist based in Suffolk, working
          across East Anglia and the United Kingdom. My practice is rooted in
          the quiet moment — the way a face settles when it forgets it is
          being watched.
        </p>
        <p>
          My work has been exhibited at Open Gallery, Halifax and Fronteer
          Gallery, Sheffield, and featured by <a
            class="link-underline"
            href="https://www.collectartwork.org/post/esme-lillico-figurative-art"
            target="_blank"
            rel="noopener noreferrer">Collect Art</a
          >.
        </p>
        <p class="about__more">
          <a href={url("/about")} class="link-underline">Read more about the practice</a>
        </p>
      </div>
    </div>
  </section>

  {/* ==================== COMMISSIONING ==================== */}
  <section class="section section--commission">
    <div class="container-page">
      <header class="section__head section__head--center">
        <p class="eyebrow">Commissioning</p>
        <h2 class="section__title">Every portrait begins with a conversation.</h2>
      </header>

      <div class="steps">
        <div class="step">
          <p class="step__title">Conversation</p>
          <p class="step__body">
            We discuss the subject, the occasion, and the size of the piece.
            Reference photographs are shared and chosen together.
          </p>
        </div>
        <div class="step">
          <p class="step__title">The Studio</p>
          <p class="step__body">
            Drawn by hand in charcoal or graphite over several weeks. You
            receive progress images and have space to give thoughts as the
            work unfolds.
          </p>
        </div>
        <div class="step">
          <p class="step__title">Delivery</p>
          <p class="step__body">
            Carefully packaged and dispatched, ready to frame. Local
            hand-delivery is available across East Anglia.
          </p>
        </div>
      </div>

      <div class="section__foot">
        <a href={url("/commissions")} class="btn">Learn about commissions</a>
      </div>
    </div>
  </section>

  {/* ==================== CONTACT ==================== */}
  <section class="section section--contact" id="contact">
    <div class="container-narrow">
      <header class="section__head section__head--center">
        <p class="eyebrow">Get in Touch</p>
        <h2 class="section__title">Begin a Commission</h2>
        <p class="section__lede">
          I read every enquiry myself. You'll hear back within a few days,
          often sooner.
        </p>
      </header>

      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     HERO
     ============================================================ */
  .hero {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-ink);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__media :global(.hero__image),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.15) 45%,
      transparent 70%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(3rem, 7vh, 6rem);
    padding-top: 8rem;
    color: #ffffff;
  }

  .hero__eyebrow {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1.4rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.005em;
    color: #ffffff;
    margin: 0 0 1.2rem;
    max-width: 18ch;
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
  }

  /* ============================================================
     SECTIONS
     ============================================================ */
  .section {
    padding-block: var(--space-2xl);
  }
  .section--selected {
    padding-top: var(--space-2xl);
  }
  .section--about {
    padding-block: var(--space-2xl);
    background: var(--color-paper);
  }
  .section--commission {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .section--contact {
    padding-block: var(--space-2xl);
  }

  .section__head {
    margin-bottom: var(--space-xl);
  }
  .section__head--center {
    text-align: center;
  }
  .section__head--center .eyebrow {
    display: inline-block;
  }

  .section__head .eyebrow {
    margin: 0 0 1rem;
  }

  .section__title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    margin: 0;
    max-width: 22ch;
  }
  .section__head--center .section__title {
    margin-inline: auto;
  }

  .section__lede {
    margin: var(--space-md) auto 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lead);
    max-width: 42ch;
  }

  .section__foot {
    margin-top: var(--space-xl);
    text-align: center;
  }

  /* ============================================================
     CATALOGUE GRID
     ============================================================ */
  .catalogue {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 3rem);
  }
  .catalogue--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .catalogue__item {
    margin: 0;
  }

  @media (max-width: 720px) {
    .catalogue--two {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================================
     ABOUT
     ============================================================ */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .about__image .plate {
    aspect-ratio: 4 / 5;
  }
  .about__name {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    margin: 0.6rem 0 var(--space-md);
    line-height: 1.05;
  }
  .about__text p {
    color: var(--color-ink);
    margin: 0 0 1.1rem;
    line-height: 1.7;
    max-width: 56ch;
  }
  .about__more {
    margin-top: var(--space-sm) !important;
  }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================================
     COMMISSIONING STEPS
     ============================================================ */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  .step__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    margin: 0 0 0.7rem;
    color: var(--color-ink);
  }
  .step__body {
    color: var(--color-ink-muted);
    margin: 0;
    line-height: 1.65;
    font-size: 0.95rem;
    max-width: 36ch;
  }
  @media (max-width: 720px) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
