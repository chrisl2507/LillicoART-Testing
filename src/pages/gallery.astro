---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { galleryArtworks } from "../data/artworks.ts";
---

<BaseLayout
  title="Gallery — Lillico Art"
  description="A catalogue of selected charcoal and graphite portraits by Esme Lillico."
>
  <section class="page-head">
    <div class="container-page">
      <p class="eyebrow">The Catalogue</p>
      <h1 class="page-head__title">Selected Works</h1>
      <p class="page-head__lede">
        A scrolling catalogue of original charcoal and graphite portraits.
      </p>
    </div>
  </section>

  <section class="container-page catalogue catalogue--three">
    {
      galleryArtworks.map((piece) => (
        <figure class="catalogue__item">
          <div class="plate">
            <Image
              src={piece.image}
              alt={piece.alt}
              widths={[400, 700, 1100]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
              loading="lazy"
            />
          </div>
          <figcaption class="label">
            <p class="label__title">{piece.title}</p>
            <p class="label__meta">{piece.medium}</p>
            <p class="label__meta">{piece.dimensions}</p>
            {piece.exhibited && (
              <p class="label__exhibited">
                <em>Exhibited:</em> {piece.exhibited}
              </p>
            )}
          </figcaption>
        </figure>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: 9rem;
    padding-bottom: var(--space-xl);
  }
  .page-head .eyebrow {
    margin: 0 0 1rem;
  }
  .page-head__title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    margin: 0 0 var(--space-sm);
    line-height: 1;
  }
  .page-head__lede {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lead);
    max-width: 50ch;
  }

  .catalogue {
    display: grid;
    gap: clamp(2.5rem, 4vw, 4rem) clamp(1.5rem, 3vw, 3rem);
    padding-bottom: var(--space-2xl);
  }
  .catalogue--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .catalogue__item {
    margin: 0;
  }

  @media (max-width: 980px) {
    .catalogue--three {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .catalogue--three {
      grid-template-columns: 1fr;
    }
  }
</style>
