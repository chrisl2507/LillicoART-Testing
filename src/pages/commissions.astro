---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { commissionExamples } from "../data/artworks.ts";
---

<BaseLayout
  title="Commissions — Lillico Art"
  description="Charcoal and graphite portrait commissions by Esme Lillico, from £150."
>
  <section class="page-head">
    <div class="container-page">
      <p class="eyebrow">Commissions</p>
      <h1 class="page-head__title">Drawn for You</h1>
      <p class="page-head__lede">
        From <strong>£150</strong>. A single portrait can take three to six
        weeks to complete. Each one begins with a conversation.
      </p>
    </div>
  </section>

  <section class="container-page commission-grid">
    {
      commissionExamples.map((p) => (
        <figure class="catalogue__item">
          <div class="plate">
            <Image
              src={p.image}
              alt={p.alt}
              widths={[400, 700, 1100]}
              sizes="(min-width: 1024px) 30vw, 92vw"
              loading="lazy"
            />
          </div>
          <figcaption class="label">
            <p class="label__title">{p.title}</p>
            <p class="label__meta">{p.medium}</p>
          </figcaption>
        </figure>
      ))
    }
  </section>

  <section class="commission-cta container-narrow">
    <header class="cta-head">
      <p class="eyebrow">Begin a Commission</p>
      <h2 class="cta-title">Tell me the story.</h2>
    </header>
    <ContactForm />
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: 9rem;
    padding-bottom: var(--space-xl);
  }
  .page-head .eyebrow {
    margin: 0 0 1rem;
  }
  .page-head__title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    margin: 0 0 var(--space-sm);
    line-height: 1;
  }
  .page-head__lede {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-lead);
    max-width: 56ch;
    line-height: 1.55;
  }
  .page-head__lede strong {
    color: var(--color-ink);
    font-weight: 500;
  }

  .commission-grid {
    padding-bottom: var(--space-2xl);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 3vw, 3rem);
  }
  .catalogue__item {
    margin: 0;
  }
  @media (max-width: 900px) {
    .commission-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .commission-grid {
      grid-template-columns: 1fr;
    }
  }

  .commission-cta {
    padding: var(--space-2xl) clamp(1.25rem, 4vw, 3rem);
    border-top: 1px solid var(--color-rule);
  }
  .cta-head {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .cta-head .eyebrow {
    display: inline-block;
    margin: 0 0 1rem;
  }
  .cta-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    margin: 0;
  }
</style>
