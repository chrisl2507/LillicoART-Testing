---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { artworks } from "../data/artworks.ts";
import { url } from "../utils/url.ts";

const portrait = artworks.find((a) => a.slug === "en-pointe")!;
---

<BaseLayout
  title="About — Esme Lillico, Charcoal Portrait Artist"
  description="About Esme Lillico — Suffolk-based charcoal and graphite portrait artist, MFA candidate, exhibited in Halifax and Sheffield."
>
  <section class="page-head">
    <div class="container-page">
      <p class="eyebrow">The Artist</p>
      <h1 class="page-head__title">Esme Lillico</h1>
    </div>
  </section>

  <section class="about container-page">
    <div class="about__image">
      <div class="plate">
        <Image
          src={portrait.image}
          alt="A study from the studio"
          widths={[480, 800, 1200]}
          sizes="(min-width: 900px) 42vw, 92vw"
          loading="eager"
        />
      </div>
    </div>
    <div class="about__text">
      <p class="lede">
        I'm a charcoal and graphite portrait artist based in Suffolk, working
        across East Anglia and the United Kingdom.
      </p>
      <p>
        My practice is rooted in the quiet moment — the way a face settles
        when it forgets it is being watched. I'm drawn to portraiture because
        it lets me sit with someone, really see them, and try to put down on
        paper what I find there.
      </p>
      <p>
        Charcoal and graphite are honest mediums. They show every hesitation,
        every confident stroke. The range from deepest black to whispered grey
        gives me the tonal vocabulary I need to draw what I'm after: presence.
      </p>
      <p>
        I'm currently an MFA candidate. My work has been exhibited at Open
        Gallery, Halifax and Fronteer Gallery, Sheffield, and featured by <a
          class="link-underline"
          href="https://www.collectartwork.org/post/esme-lillico-figurative-art"
          target="_blank"
          rel="noopener noreferrer">Collect Art</a
        >.
      </p>
    </div>
  </section>

  <section class="about-cta">
    <div class="container-narrow about-cta__inner">
      <p class="eyebrow">Begin a Conversation</p>
      <h2 class="about-cta__title">Every portrait begins with a conversation.</h2>
      <a href={`${url("/")}#contact`} class="btn">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: 9rem;
    padding-bottom: var(--space-xl);
  }
  .page-head .eyebrow {
    margin: 0 0 1rem;
  }
  .page-head__title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    margin: 0;
    line-height: 1;
  }

  .about {
    padding-block: var(--space-md) var(--space-2xl);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .about__text p {
    color: var(--color-ink);
    margin: 0 0 1.2rem;
    line-height: 1.75;
    max-width: 56ch;
  }
  .about__text .lede {
    font-family: var(--font-display);
    font-size: var(--text-lead);
    color: var(--color-ink);
    line-height: 1.5;
    margin-bottom: 1.6rem;
  }

  .about-cta {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-rule);
    text-align: center;
  }
  .about-cta__inner .eyebrow {
    display: inline-block;
    margin: 0 0 1rem;
  }
  .about-cta__title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    margin: 0 auto var(--space-xl);
    max-width: 22ch;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
