---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../utils/url.ts";
---

<BaseLayout
  title="Thank You — Lillico Art"
  description="Your message has been received. Esme will be in touch soon."
>
  <section class="thanks">
    <div class="container-narrow thanks__inner">
      <p class="eyebrow">Message Received</p>
      <h1 class="thanks__title">Thank you.</h1>
      <p class="thanks__body">
        Your message has arrived in the studio. I read every enquiry myself —
        you'll hear back within a few days, often sooner.
      </p>
      <div class="thanks__actions">
        <a href={url("/")} class="btn">Return Home</a>
        <a href={url("/gallery")} class="link-underline">
          Or browse the gallery
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    min-height: 80svh;
    display: grid;
    place-items: center;
    padding: 9rem 0 var(--space-2xl);
  }
  .thanks__inner {
    text-align: center;
  }
  .thanks__inner .eyebrow {
    display: inline-block;
    margin: 0 0 1rem;
  }
  .thanks__title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    margin: 0 0 var(--space-md);
    line-height: 1;
  }
  .thanks__body {
    font-size: var(--text-lead);
    color: var(--color-ink-muted);
    margin: 0 auto var(--space-xl);
    max-width: 44ch;
    line-height: 1.6;
  }
  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
    align-items: center;
  }
</style>
