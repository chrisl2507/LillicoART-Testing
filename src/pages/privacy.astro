---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy Policy — Lillico Art"
  description="Privacy policy for lillicoart.com."
>
  <section class="page-head">
    <div class="container-page">
      <p class="eyebrow">Privacy</p>
      <h1 class="page-head__title">Privacy Policy</h1>
    </div>
  </section>

  <article class="prose container-narrow">
    <p>
      Lillico Art ("we", "I") respects your privacy. This policy explains what
      information we collect and how it is used.
    </p>

    <h2>What we collect</h2>
    <p>
      When you submit the contact form, we collect your name, email address,
      and the contents of your message. This is processed by Netlify Forms on
      our behalf and emailed to lilli.co.art@gmail.com.
    </p>

    <h2>Cookies</h2>
    <p>
      This site uses only essential cookies needed for navigation. No tracking
      or analytics cookies are used without consent.
    </p>

    <h2>Your rights</h2>
    <p>
      You can request that we delete any personal information we hold about
      you at any time. Email <a class="link-underline" href="mailto:lilli.co.art@gmail.com"
        >lilli.co.art@gmail.com</a
      > and we'll respond promptly.
    </p>
  </article>
</BaseLayout>

<style>
  .page-head {
    padding-top: 9rem;
    padding-bottom: var(--space-xl);
  }
  .page-head .eyebrow {
    margin: 0 0 1rem;
  }
  .page-head__title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    margin: 0;
    line-height: 1;
  }

  .prose {
    padding: var(--space-md) clamp(1.25rem, 4vw, 3rem) var(--space-2xl);
  }
  .prose p {
    color: var(--color-ink);
    margin: 0 0 1.2rem;
    line-height: 1.75;
  }
  .prose h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 1.9rem);
    font-weight: 400;
    margin: var(--space-lg) 0 var(--space-sm);
  }
</style>
